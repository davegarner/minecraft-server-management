<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Version>1.0.3</Version>
    <Product>Minecraft Server Manager</Product>
    <!-- Publish as a single self-contained executable (see scripts/publish.ps1). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Company>Minecraft Server Manager</Company>
    <Description>Web control panel for a Minecraft Java Edition server</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.Tests" />
  </ItemGroup>

  <!-- Ship the Windows service helper scripts next to the published executable. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Include="..\..\scripts\install-service.ps1;..\..\scripts\uninstall-service.ps1" Link="%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
