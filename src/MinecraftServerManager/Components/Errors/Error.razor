@page "/error"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.Diagnostics

<PageTitle>Error · Minecraft Server Manager</PageTitle>

<h1 class="auth-title">Something went wrong</h1>
<p class="muted">An error occurred while processing your request. Details are written to the application log.</p>
@if (RequestId is not null)
{
    <p class="small muted">Request ID: <code>@RequestId</code></p>
}
<a class="btn btn-primary btn-block" href="">Back to dashboard</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
