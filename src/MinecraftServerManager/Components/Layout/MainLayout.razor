@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app @(_navOpen ? "nav-open" : "")">
    <aside class="sidebar">
        <a class="brand" href="">
            <span class="logo-block" aria-hidden="true"></span>
            <span class="brand-text">
                <span class="brand-name">Minecraft</span>
                <span class="brand-sub">Server Manager</span>
            </span>
        </a>
        <nav class="nav" @onclick="() => _navOpen = false">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="gauge" /> Dashboard</NavLink>
            <NavLink class="nav-link" href="console"><Icon Name="terminal" /> Console</NavLink>
            <NavLink class="nav-link" href="properties"><Icon Name="sliders" /> Server Properties</NavLink>
            <NavLink class="nav-link" href="worlds"><Icon Name="globe" /> Worlds</NavLink>
            <NavLink class="nav-link" href="backups"><Icon Name="archive" /> Backups</NavLink>
            <NavLink class="nav-link" href="updates"><Icon Name="download" /> Updates</NavLink>
            <NavLink class="nav-link" href="players"><Icon Name="users" /> Players</NavLink>
            <NavLink class="nav-link" href="settings"><Icon Name="settings" /> Settings</NavLink>
        </nav>
        <div class="sidebar-footer">
            <span class="muted small">Java Edition server</span>
        </div>
    </aside>
    <div class="nav-scrim" @onclick="() => _navOpen = false"></div>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn nav-toggle" aria-label="Toggle navigation" @onclick="() => _navOpen = !_navOpen">
                <Icon Name="menu" Size="20" />
            </button>
            <StatusPill />
            <div class="topbar-spacer"></div>
            <AuthorizeView>
                <span class="muted small topbar-user">@context.User.Identity?.Name</span>
            </AuthorizeView>
            <button class="icon-btn" aria-label="Switch between light and dark theme" title="Switch between light and dark theme"
                    @onclick="ToggleThemeAsync">
                <Icon Name="theme" Size="18" />
            </button>
            <form method="post" action="logout" class="inline-form">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost btn-sm"><Icon Name="logout" Size="16" /> Sign out</button>
            </form>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navOpen;

    private async Task ToggleThemeAsync() => await JS.InvokeVoidAsync("mcm.toggleTheme");
}
